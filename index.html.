<!DOCTYPE html>

<html lang="fr">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="theme-color" content="#10111a">

  <title>HAM IA</title>

  <style>

    * { box-sizing: border-box; }

    body {

      margin: 0;

      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

      background: #10111a;

      color: #fff;

      min-height: 100vh;

    }

    header {

      padding: 22px 18px;

      border-bottom: 1px solid #292b3b;

      display: flex;

      align-items: center;

      gap: 12px;

    }

    .logo {

      width: 43px;

      height: 43px;

      border-radius: 14px;

      display: grid;

      place-items: center;

      background: linear-gradient(135deg, #8b5cf6, #2563eb);

      font-weight: 900;

      font-size: 18px;

    }

    h1 { margin: 0; font-size: 21px; }

    .status { color: #aaaabd; font-size: 12px; margin-top: 4px; }

    main {

      max-width: 760px;

      margin: auto;

      padding: 22px 16px 120px;

    }

    .welcome {

      text-align: center;

      padding: 42px 12px 28px;

    }

    .welcome .symbol { font-size: 42px; }

    .welcome h2 { font-size: 25px; margin: 12px 0 8px; }

    .welcome p { color: #aaaabd; line-height: 1.5; margin: 0; }

    #messages { display: flex; flex-direction: column; gap: 14px; }

    .message {

      max-width: 88%;

      padding: 13px 15px;

      border-radius: 17px;

      line-height: 1.5;

      white-space: pre-wrap;

      overflow-wrap: anywhere;

    }

    .user {

      align-self: flex-end;

      background: #6544c8;

      border-bottom-right-radius: 5px;

    }

    .assistant {

      align-self: flex-start;

      background: #222435;

      border: 1px solid #303247;

      border-bottom-left-radius: 5px;

    }

    .composer {

      position: fixed;

      bottom: 0;

      left: 0;

      right: 0;

      padding: 14px 14px calc(14px + env(safe-area-inset-bottom));

      background: #10111a;

      border-top: 1px solid #292b3b;

    }

    form {

      max-width: 760px;

      margin: auto;

      display: flex;

      gap: 9px;

    }

    input {

      flex: 1;

      min-width: 0;

      border: 1px solid #383a50;

      border-radius: 16px;

      padding: 15px;

      background: #202233;

      color: white;

      font-size: 16px;

      outline: none;

    }

    input:focus { border-color: #8b5cf6; }

    button {

      width: 52px;

      border: 0;

      border-radius: 16px;

      background: linear-gradient(135deg, #8b5cf6, #2563eb);

      color: white;

      font-size: 22px;

      font-weight: bold;

    }

    .note {

      text-align: center;

      color: #77798e;

      font-size: 11px;

      margin: 9px 0 0;

    }

  </style>

</head>

<body>

  <header>

    <div class="logo">H</div>

    <div>

      <h1>HAM IA</h1>

      <div class="status">Ton assistant personnel</div>

    </div>

  </header>

  <main>

    <section class="welcome" id="welcome">

      <div class="symbol">✦</div>

      <h2>Salut ! Je suis HAM IA.</h2>

      <p>Ton espace pour discuter, apprendre, réfléchir et créer.<br>

      Écris ton premier message ci-dessous.</p>

    </section>

    <section id="messages"></section>

  </main>

  <div class="composer">

    <form id="chatForm">

      <input id="messageInput" type="text" placeholder="Écris ton message..." autocomplete="off">

      <button type="submit" aria-label="Envoyer">➤</button>

    </form>

    <p class="note">Première version de HAM IA</p>

  </div>

  <script>

    const form = document.getElementById("chatForm");

    const input = document.getElementById("messageInput");

    const messages = document.getElementById("messages");

    const welcome = document.getElementById("welcome");

    function addMessage(text, type) {

      welcome.style.display = "none";

      const bubble = document.createElement("div");

      bubble.className = "message " + type;

      bubble.textContent = text;

      messages.appendChild(bubble);

      window.scrollTo(0, document.body.scrollHeight);

    }

    form.addEventListener("submit", function(event) {

      event.preventDefault();

      const text = input.value.trim();

      if (!text) return;

      addMessage(text, "user");

      input.value = "";

      setTimeout(function() {

        addMessage(

          "CART3R.JAILBREAK : Ton message est bien reçu ! L'interface de HAM IA fonctionne. Le moteur d'intelligence artificielle sera connecté à la prochaine étape.",

          "assistant"

        );

      }, 400);

    });

  </script>

</body>

</html>
